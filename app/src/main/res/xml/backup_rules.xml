<?xml version="1.0" encoding="utf-8"?>
<!--
  Design doc §6: nothing leaves the device. There is no app data to back up, so
  every domain is excluded rather than left to the platform default.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
